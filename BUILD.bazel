# Full raw-session and axis-equivalence engine checks exceed the 900-second
# large-test limit in Crabbox. Test resource sizes do not change application
# deadlines or durability assertions.
INTEGRATION_TEST_SIZES = {
    "calibration-engine-contract-test": "enormous",
    "evaluation-contract-test": "large",
    "physical-study-contract-test": "large",
    "pilot-contract-test": "large",
    "replay-contract-test": "medium",
    "manifest-contract-test": "medium",
}

[
    rust_test(
        name = name,
        srcs = [source],
        crate_root = source,
        compile_data = [
            "configs/acquisition-template.example.json",
            "configs/axis-characterization-template.example.json",
            "configs/rig-evidence-template.example.json",
        ],
        edition = RUST_EDITION,
        rustc_flags = RUSTC_FLAGS,
        data = ["//firmware/zephyr:native-conformance-test"] if name == "gate0-trace-contract-test" else [],
        env = {
            "IKB_STARTUP_FIXTURE_RLOCATION": "$(rlocationpath //firmware/zephyr:native-conformance-test)",
        } if name == "gate0-trace-contract-test" else {},
        # Replay and manifest suites repeatedly reduce evidence-bound fixtures.
        # A cold parallel firmware build can push these beyond 60 seconds.
        size = INTEGRATION_TEST_SIZES.get(name, "small"),
        deps = [
            ":invisible_keyboard",
            "@crates//:serde_json",
        ],
    )
    for name, source in INTEGRATION_TESTS.items()
]

# This target uses Linux uinput plus an exclusively grabbed evdev consumer.
# It skips when the capability is absent unless the caller sets
# INVISIBLE_KEYBOARD_REQUIRE_UINPUT=1.
rust_test(
    name = "output-system-contract-test",
    srcs = ["tests/output-system-contract.rs"],
    crate_root = "tests/output-system-contract.rs",
    edition = RUST_EDITION,
    rustc_flags = RUSTC_FLAGS,
    size = "medium",
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":invisible_keyboard",
        "@crates//:evdev",
        "@crates//:libc",
        "@crates//:signal-hook",
    ],
)

# Explicit hardware-backed acceptance lane. The environment variable turns
# every otherwise portable uinput skip into a test failure, while no-sandbox
# exposes the Box host's real /dev/uinput device to the test process.
rust_test(
    name = "output-system-required-test",
    srcs = ["tests/output-system-contract.rs"],
    crate_root = "tests/output-system-contract.rs",
    edition = RUST_EDITION,
    env = {"INVISIBLE_KEYBOARD_REQUIRE_UINPUT": "1"},
    rustc_flags = RUSTC_FLAGS,
    size = "medium",
    tags = [
        "exclusive",
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        ":invisible_keyboard",
        "@crates//:evdev",
        "@crates//:libc",
        "@crates//:signal-hook",
    ],
)

rust_test(
    name = "cli-contract-test",
    args = ["--test-threads=1"],
    srcs = ["tests/cli-contract.rs"],
    crate_root = "tests/cli-contract.rs",
    data = [
        ":firmware-frame-conformance-test",
        ":invisible-keyboard",
    ],
    edition = RUST_EDITION,
    env = {
        "FIRMWARE_FIXTURE_RLOCATION": "$(rlocationpath :firmware-frame-conformance-test)",
        "INVISIBLE_KEYBOARD_RLOCATION": "$(rlocationpath :invisible-keyboard)",
    },
    rustc_flags = RUSTC_FLAGS,
    size = "large",
    # The sequential CLI suite includes full synthetic and sparse-file runs;
    # its total runtime can exceed the medium target's five-minute allowance.
    # Several cases drive two real FIFOs and assert that the causal live clock
    # arms. CPU starvation is expected to keep output disarmed or fail closed.
    # `exclusive` isolates this binary from other Bazel tests; the explicit
    # harness argument also prevents the long resource case from starving the
    # timing-sensitive live cases inside this same test binary.
    tags = ["exclusive"],
    deps = [
        ":invisible_keyboard",
        "@crates//:libc",
        "@crates//:serde_json",
    ],
)

