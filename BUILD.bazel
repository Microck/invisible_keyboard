])

RUST_EDITION = "2024"
RUSTC_FLAGS = [
    "-Dwarnings",
    # Unsafe remains denied by default. Narrow libc FFI boundaries opt in at
    # the item level, where each call carries its local safety proof.
    "-Dunsafe-code",
]
C_COPTS = [
    "-std=c11",
    "-Wall",
    "-Wextra",
    "-Werror",
    "-pedantic",
]

rust_library(
    name = "invisible_keyboard",
    srcs = glob(["src/*.rs"], exclude = ["src/main.rs"]),
    compile_data = [
        "web/calibration-app.js",
        "web/calibration.css",
        "web/calibration.html",
    ],
    crate_name = "invisible_keyboard",
    crate_root = "src/lib.rs",
    edition = RUST_EDITION,
    rustc_flags = RUSTC_FLAGS,
    deps = select({
        "@platforms//os:linux": [
            "@crates//:evdev",
            "@crates//:libc",
        ],
        "//conditions:default": [],
    }) + [
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
    ],
)

rust_binary(
    name = "invisible-keyboard",
    srcs = ["src/main.rs"],
    crate_name = "invisible_keyboard_cli",
    edition = RUST_EDITION,
    rustc_flags = RUSTC_FLAGS,
    deps = [
        ":invisible_keyboard",
        "@crates//:serde_json",
        "@crates//:signal-hook",
    ],
)

