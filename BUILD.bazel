# The capture executable itself is compiled by the pinned Box-only recipe.
# These Bazel targets own the project wrappers and their contract suite so
# Bazel remains the canonical command surface without adding a Python ruleset.
sh_binary(
    name = "build-gate0a-capture-stack",
    srcs = ["tools/build-gate0a-capture-stack.sh"],
    data = [
        "third_party/gate0a-capture-stack-provenance.md",
        "third_party/libsigrok-0bc2487-dslogic-gate0a.patch",
    ],
    env = {
        "IKB_GATE0A_PATCH_RLOCATION": "$(rlocationpath third_party/libsigrok-0bc2487-dslogic-gate0a.patch)",
        "IKB_GATE0A_PROVENANCE_RLOCATION": "$(rlocationpath third_party/gate0a-capture-stack-provenance.md)",
    },
    # The launcher exports RUNFILES_DIR or RUNFILES_MANIFEST_FILE before it
    # enters the recipe. The recipe refuses to guess paths outside that tree.
    use_bash_launcher = True,
)

sh_binary(
    name = "capture-gate0a",
    srcs = ["tools/capture-gate0a.py"],
)

sh_binary(
    name = "finalize-gate0a-capture",
    srcs = ["tools/finalize-gate0a-capture.py"],
)

sh_test(
    name = "gate0a-capture-stack-test",
    srcs = ["tools/test-gate0a-capture-stack.py"],
    data = [
        ":build-gate0a-capture-stack",
        "docs/implementation/gate0a-capture-stack.md",
        "third_party/gate0a-capture-stack-provenance.md",
        "third_party/libsigrok-0bc2487-dslogic-gate0a.patch",
        "tools/build-gate0a-capture-stack.sh",
        "tools/capture-gate0a.py",
        "tools/finalize-gate0a-capture.py",
    ],
    env = {
        "IKB_GATE0A_BUILD_RLOCATION": "$(rlocationpath :build-gate0a-capture-stack)",
        "IKB_GATE0A_PATCH_RLOCATION": "$(rlocationpath third_party/libsigrok-0bc2487-dslogic-gate0a.patch)",
        "IKB_GATE0A_PROVENANCE_RLOCATION": "$(rlocationpath third_party/gate0a-capture-stack-provenance.md)",
    },
    # This suite hashes a 14.44 GB logical capture; slow storage must not turn
    # that intentional resource test into a one-minute harness timeout.
    size = "large",
    # The generated capture binary and firmware tar are supplied only by the
    # explicit Crabbox lane. Missing --test_env inputs fail, never skip.
    tags = ["manual"],
)

# This manual Linux oracle follows the real CLI with ptrace and rejects any
# durable-status publication that precedes the END3 footer plus file and parent
# directory fsyncs for the manifest, session, and exact-session-bound report.
sh_test(
    name = "live-durability-syscall-test",
    srcs = ["tools/test-live-durability-syscalls.py"],
    data = [
        ":cli-contract-test",
        ":invisible-keyboard",
    ],
    env = {
        "IKB_DURABILITY_CLI_TEST_RLOCATION": "$(rlocationpath :cli-contract-test)",
        "INVISIBLE_KEYBOARD_RLOCATION": "$(rlocationpath :invisible-keyboard)",
    },
    size = "medium",
    tags = [
        "exclusive",
        "manual",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

# Real Chrome exercises the production UI and loopback HTTP service while a
